{
  "manifestVersion": 1,
  "id": "com.alexzavalny.chess-results",
  "name": "Chess Results",
  "version": "1.1.0",
  "description": "Tournaments, standings and player results from Chess-Results, via the Easy Chess Results API.",
  "author": "Alex Zavalny",
  "entry": "index.html",
  "icon": "assets/icon.png",
  "window": {
    "width": 1120,
    "height": 740,
    "minWidth": 780,
    "minHeight": 480,
    "resizable": true,
    "titleBarStyle": "hiddenInset",
    "material": "sidebar"
  },
  "permissions": [
    "network",
    "storage",
    "notifications"
  ]
}

{
  "manifestVersion": 1,
  "id": "com.example.paint",
  "name": "Paint",
  "version": "1.0.0",
  "description": "A pixel paint program with the sixteen tools of classic Paint, native menus and sheets, PNG, BMP and JPEG files.",
  "author": "JApp Examples",
  "entry": "index.html",
  "icon": "assets/icon.png",
  "window": {
    "width": 1000,
    "height": 720,
    "minWidth": 640,
    "minHeight": 480,
    "resizable": true,
    "titleBarStyle": "hiddenInset",
    "material": "sidebar"
  },
  "permissions": [
    "dialog",
    "storage"
  ]
}

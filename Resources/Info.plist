<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>JAppRuntime</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>dev.japp.runtime</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>JApp Runtime</string>
	<key>CFBundleDisplayName</key>
	<string>JApp Runtime</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>__VERSION__</string>
	<key>CFBundleVersion</key>
	<string>__BUILD__</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.developer-tools</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSSupportsAutomaticTermination</key>
	<false/>
	<key>NSSupportsSuddenTermination</key>
	<false/>

	<!-- .japp files open in JApp Runtime (double-click in Finder). -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>JApp Application</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>CFBundleTypeIconFile</key>
			<string>JAppDocument</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>dev.japp.app</string>
			</array>
		</dict>
	</array>

	<!-- The .japp file type: a ZIP archive with a manifest.json at its root. -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>dev.japp.app</string>
			<key>UTTypeDescription</key>
			<string>JApp Application</string>
			<key>UTTypeIconFile</key>
			<string>JAppDocument</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.content</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>japp</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.japp+zip</string>
				</array>
			</dict>
		</dict>
	</array>

	<!-- Finder › right-click › Services (or Quick Actions) › Edit JApp Source. -->
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Edit JApp Source</string>
			</dict>
			<key>NSMessage</key>
			<string>editJAppSource</string>
			<key>NSPortName</key>
			<string>JApp Runtime</string>
			<key>NSRequiredContext</key>
			<dict/>
			<key>NSSendFileTypes</key>
			<array>
				<string>dev.japp.app</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
